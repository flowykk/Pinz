# Скопировать в .env (или передать как переменные окружения сидеру/k6)
# и заполнить под свой стенд.

# Базовый URL backend на loadtest-стенде (виден с ноута, где запускается k6).
BASE_URL=http://<VPS_IP>:8080

# Подключение к Postgres auth-сервиса для cleanup-скрипта.
LOADTEST_DB_URL=postgresql://pinz_user:pinz_password@<VPS_IP>:5432/pinz_db?sslmode=disable

# MinIO (S3-mock) — для cleanup-s3.sh.
S3_ENDPOINT=http://<VPS_IP>:9000
S3_BUCKET=pinz-loadtest
S3_KEY_PREFIX=loadtest/
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
