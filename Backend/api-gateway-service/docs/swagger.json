    "definitions": {
        "pinz_backend_api-gateway-service_internal_requests.DevLoginRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "dev@example.com"
                }
            }
        },
        "pinz_backend_api-gateway-service_internal_requests.LogoutRequest": {
            "type": "object",
            "properties": {
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "pinz_backend_api-gateway-service_internal_requests.PasskeyLoginBeginRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "user@example.com"
                }
            }
        },
        "pinz_backend_api-gateway-service_internal_requests.PasskeyLoginFinishRequest": {
            "type": "object",
            "properties": {
                "credential_json": {
                    "description": "CredentialJSON is the PublicKeyCredential (assertion) object serialised to JSON by the client.",
                    "type": "string",
                    "format": "base64"
                },
                "email": {
                    "type": "string",
                    "example": "user@example.com"
                }
            }
        },
        "pinz_backend_api-gateway-service_internal_requests.PasskeyRegisterBeginRequest": {
            "type": "object",
            "properties": {
                "registration_id": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "pinz_backend_api-gateway-service_internal_requests.PasskeyRegisterFinishRequest": {
            "type": "object",
            "properties": {
                "credential_json": {
                    "description": "CredentialJSON is the PublicKeyCredential (attestation) object serialised to JSON by the client.",
                    "type": "string",
                    "format": "base64"
                },
                "registration_id": {
                    "type": "string"
                }
            }
        },
        "pinz_backend_api-gateway-service_internal_requests.RefreshTokenRequest": {
            "type": "object",
            "properties": {
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "pinz_backend_api-gateway-service_internal_requests.SubmitEmailRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "user@example.com"
                }
            }
        },
        "pinz_backend_api-gateway-service_internal_requests.VerifyEmailCodeRequest": {
            "type": "object",
            "properties": {
                "registration_id": {
                    "type": "string"
                },
                "verification_code": {
                    "type": "string"
                }
            }
        },
        "pinz_backend_api-gateway-service_internal_responses.DevLoginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "pinz_backend_api-gateway-service_internal_responses.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "pinz_backend_api-gateway-service_internal_responses.LogoutResponse": {
            "type": "object",
            "properties": {
                "success": {
                    "type": "boolean"
                }
            }
