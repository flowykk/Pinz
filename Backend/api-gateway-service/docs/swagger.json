{
    "swagger": "2.0",
    "info": {
        "description": "API Gateway for Pinz mobile client",
        "title": "Pinz API Gateway",
        "contact": {},
        "version": "1.0"
    },
    "host": "pinz.website",
    "basePath": "/",
    "paths": {
        "/api/v1/auth/dev-login": {
            "post": {
                "description": "For development use only. Returns access and refresh tokens for any existing user without passkey verification.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Dev login — bypass passkey, get tokens by email only",
                "parameters": [
                    {
                        "description": "User email",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_requests.DevLoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.DevLoginResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/email": {
            "post": {
                "description": "User sends email. Response indicates if user is registered (next step: passkey login) or not (next step: email verification). registration_id is set only when is_registered is false.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Submit email (login or registration flow)",
                "parameters": [
                    {
                        "description": "Email",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_requests.SubmitEmailRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.SubmitEmailResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Logout",
                "parameters": [
                    {
                        "description": "Refresh token",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_requests.LogoutRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.LogoutResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/passkey/login/begin": {
            "post": {
                "description": "Returns PublicKeyCredentialRequestOptions (options_json) to pass to navigator.credentials.get(). Call after /auth/email confirms is_registered=true.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Begin passkey login (step 1 of 2)",
                "parameters": [
                    {
                        "description": "User email",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_requests.PasskeyLoginBeginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.PasskeyLoginBeginResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/passkey/login/finish": {
            "post": {
                "description": "Verifies the assertion from the authenticator. Returns access and refresh tokens.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Finish passkey login (step 2 of 2)",
                "parameters": [
                    {
                        "description": "User email and assertion credential JSON",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_requests.PasskeyLoginFinishRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.PasskeyLoginFinishResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/passkey/register/begin": {
            "post": {
                "description": "Returns PublicKeyCredentialCreationOptions (options_json) to pass to navigator.credentials.create(). Call after email verification.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Begin passkey registration (step 1 of 2)",
                "parameters": [
                    {
                        "description": "Registration ID and username",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_requests.PasskeyRegisterBeginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.PasskeyRegisterBeginResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/passkey/register/finish": {
            "post": {
                "description": "Verifies the attestation from the authenticator and creates the user account. Returns access and refresh tokens.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Finish passkey registration (step 2 of 2)",
                "parameters": [
                    {
                        "description": "Registration ID and attestation credential JSON",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_requests.PasskeyRegisterFinishRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.PasskeyRegisterFinishResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_responses.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/refresh": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Refresh access token",
                "parameters": [
                    {
                        "description": "Refresh token",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/pinz_backend_api-gateway-service_internal_requests.RefreshTokenRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
