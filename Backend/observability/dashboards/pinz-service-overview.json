{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Pinz services — RED metrics, auth business counters, Go runtime",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "asDropdown": false, "icon": "doc", "includeVars": true, "keepTime": true, "tags": ["pinz", "observability"], "targetBlank": false, "title": "Logs", "tooltip": "", "type": "dashboard", "uid": "pinz-logs" },
    { "asDropdown": false, "icon": "list-ul", "includeVars": true, "keepTime": true, "tags": ["pinz", "observability"], "targetBlank": false, "title": "Traces", "tooltip": "", "type": "dashboard", "uid": "pinz-traces" }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "API Gateway — HTTP",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(pinz_http_server_request_duration_seconds_count[1m])) by (http_request_method, http_route)",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(pinz_http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[1m])) / sum(rate(pinz_http_server_request_duration_seconds_count[1m]))",
          "legendFormat": "Error rate",
          "refId": "A"
        }
      ],
      "title": "Error Rate (5xx)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(pinz_http_server_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(pinz_http_server_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(pinz_http_server_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "C"
        }
      ],
      "title": "Request Duration",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Auth Service — gRPC",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(pinz_rpc_server_call_duration_seconds_count{job=\"auth-service\"}[1m])) by (rpc_method)",
          "legendFormat": "{{rpc_method}}",
          "refId": "A"
        }
      ],
      "title": "gRPC Request Rate (auth-service)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 7,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(pinz_rpc_server_call_duration_seconds_bucket{job=\"auth-service\"}[1m])) by (le, rpc_method))",
          "legendFormat": "p99 {{rpc_method}}",
          "refId": "A"
        }
      ],
      "title": "gRPC Duration p99 (auth-service)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 8,
      "targets": [
        {
          "expr": "sum(rate(pinz_rpc_server_call_duration_seconds_count{job=\"auth-service\",rpc_response_status_code!=\"OK\"}[1m])) by (rpc_method)",
          "legendFormat": "errors {{rpc_method}}",
          "refId": "A"
        }
      ],
      "title": "gRPC Error Rate (auth-service)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 9,
      "title": "Auth Business Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 10,
      "targets": [
        {
          "expr": "sum(increase(pinz_auth_logins_total{job=\"auth-service\"}[5m])) by (method, status)",
          "legendFormat": "{{method}} / {{status}}",
          "refId": "A"
        }
      ],
      "title": "Logins (5m window)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 11,
      "targets": [
        {
          "expr": "sum(increase(pinz_auth_registrations_total{job=\"auth-service\"}[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "Registrations (5m window)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 12,
      "targets": [
        {
          "expr": "sum(increase(pinz_auth_token_refresh_total{job=\"auth-service\"}[5m]))",
          "legendFormat": "Token refreshes",
          "refId": "A"
        }
      ],
      "title": "Token Refreshes (5m window)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 13,
      "title": "Go Runtime",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "id": 14,
      "targets": [
        {
          "expr": "pinz_go_goroutine_count{job=~\"api-gateway-service|auth-service\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Goroutines",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "id": 15,
      "targets": [
        {
          "expr": "pinz_go_memory_used_bytes{job=~\"api-gateway-service|auth-service\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Heap memory used",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "id": 16,
      "targets": [
        {
          "expr": "pinz_go_memory_allocated_bytes_total{job=~\"api-gateway-service|auth-service\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Heap allocated (cumulative)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["pinz", "observability"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Pinz — Service Overview",
  "uid": "pinz-service-overview",
  "version": 1
}
