repositories: []

releases:
  - name: auth-service
    namespace: default
    chart: ./helm/auth-service
    values:
      - image:
          repository: "{{ env "DOCKER_REGISTRY" | default "ghcr.io" }}/{{ env "DOCKER_REPO" | default "dmitry-pr" }}/pinz-auth-service"
          tag: "{{ env "IMAGE_TAG" | default "latest" }}"
          pullPolicy: Always
      - env:
          dbHost: "db"
          dbPort: "5432"
          dbUser: pinz_user
          dbName: pinz_db
          redisAddr: "redis:6379"
          grpcPort: ":50051"
          otelExporterEndpoint: "otel-collector.default.svc.cluster.local:4317"
          otelServiceName: "auth-service"
          otelTracesSampler: "parentbased_traceidratio"
          otelTracesSamplerArg: "1.0"
      - env:
          smtpHost: "{{ env "SMTP_HOST" | default "" }}"
          smtpPort: "{{ env "SMTP_PORT" | default "587" }}"
          smtpFrom: "{{ env "SMTP_FROM" | default "" }}"
      - secret:
          dbPassword: "{{ env "POSTGRES_PASSWORD" | default "pinz_password" }}"
          jwtSecretKey: "{{ env "JWT_SECRET_KEY" | default "change-me-in-production" }}"
          smtpUsername: "{{ env "SMTP_USERNAME" | default "" }}"
          smtpPassword: "{{ env "SMTP_PASSWORD" | default "" }}"

  - name: trip-service
    namespace: default
    chart: ./helm/trip-service
    values:
      - image:
          repository: "{{ env "DOCKER_REGISTRY" | default "ghcr.io" }}/{{ env "DOCKER_REPO" | default "dmitry-pr" }}/pinz-trip-service"
          tag: "{{ env "IMAGE_TAG" | default "latest" }}"
          pullPolicy: Always
      - env:
          dbHost: "db-trips"
          dbPort: "5433"
          dbUser: pinz_user
          dbName: pinz_trips
          redisAddr: "redis:6379"
          grpcPort: ":50052"
          otelExporterEndpoint: "otel-collector.default.svc.cluster.local:4317"
          otelServiceName: "trip-service"
          otelTracesSampler: "parentbased_always_on"
          otelTracesSamplerArg: "1.0"
          s3Endpoint: "{{ env "S3_ENDPOINT" | default "https://storage.yandexcloud.net" }}"
          s3Region: "{{ env "S3_REGION" | default "ru-central1" }}"
          s3Bucket: "{{ env "S3_BUCKET" | default "" }}"
          s3PresignTTL: "{{ env "S3_PRESIGN_TTL" | default "15m" }}"
          geocodingBaseUrl: "{{ env "GEOCODING_BASE_URL" | default "https://api.bigdatacloud.net/data/reverse-geocode-client" }}"
      - secret:
          dbPassword: "{{ env "POSTGRES_PASSWORD" | default "pinz_password" }}"
          s3AccessKey: "{{ env "S3_ACCESS_KEY" | default "" }}"
          s3SecretKey: "{{ env "S3_SECRET_KEY" | default "" }}"
          geocodingApiKey: "{{ env "GEOCODING_API_KEY" | default "" }}"

  - name: api-gateway
    namespace: default
    chart: ./helm/api-gateway
    needs:
      - default/auth-service
      - default/trip-service
    values:
      - image:
          repository: "{{ env "DOCKER_REGISTRY" | default "ghcr.io" }}/{{ env "DOCKER_REPO" | default "dmitry-pr" }}/pinz-api-gateway"
          tag: "{{ env "IMAGE_TAG" | default "latest" }}"
          pullPolicy: Always
      - env:
          apiGatewayPort: "8080"
          authServiceGrpcAddress: auth-service.default.svc.cluster.local:50051
          tripServiceGrpcAddress: trip-service.default.svc.cluster.local:50052
          otelExporterEndpoint: "otel-collector.default.svc.cluster.local:4317"
          otelServiceName: "api-gateway-service"
          otelTracesSampler: "parentbased_traceidratio"
          otelTracesSamplerArg: "1.0"